theme = Rose Pine
background = #111019
font-size = 28
window-padding-x = 10
window-padding-y = 10
cursor-style = block
shell-integration = zsh
shell-integration-features = no-cursor,no-sudo,no-title,ssh-env
macos-titlebar-style = hidden
macos-option-as-alt = true
mouse-scroll-multiplier = 0.5
mouse-hide-while-typing = true
confirm-close-surface = false
